# ==============================================================================
# .gitignore Colaborativo - Funeraria Cristo Rey
# ==============================================================================

# 1. Dependencias (cada integrante debe instalarlas con composer/npm)
/vendor/
/node_modules/

# 2. Entorno y credenciales (JAMÁS deben subirse al repositorio)
.env
.env.backup
.env.production
.env.*.local
*.key
/auth.json

# 3. Archivos y carpetas generadas en tiempo de ejecución / compilación
/storage/*.key
/storage/pail
/storage/app/public/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!/storage/app/public/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore
public/storage
public/build
public/hot

# 4. Pruebas, logs y caches de desarrollo
/.phpunit.cache
.phpunit.result.cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.phpactor.json

# 5. Configuraciones locales de editores y del sistema operativo
.vscode/
.idea/
.fleet/
.nova/
.zed/
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Homestead.json
Homestead.yaml
